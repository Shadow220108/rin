	(text "3. CH340C USB-UART"
		(exclude_from_sim no)
		(at 149.86 26.67 0)
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "21d53191-6fac-4d3c-9e6c-faaf220706bd")
	)
	(text "5.1K Rd on CC1/CC2 = USB-C sink (gets 5V from any host/charger).\nF1 polyfuse protects the host if the target shorts. U2 = ESD on D+/D-."
		(exclude_from_sim no)
		(at 15.24 102.87 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "269327a9-bb22-4d3a-a845-7e8ea051d761")
	)
	(text "1. USB-C input + protection"
		(exclude_from_sim no)
		(at 13.97 26.67 0)
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "47e3a183-93e2-4a26-82e0-7d912d7cfc06")
	)
	(text "Q1/Q2 = standard ESP32 auto-reset:\nesptool toggles DTR/RTS to pull EN and IO0.\nJ2 = FTDI pinout (Arduino Pro Mini etc)."
		(exclude_from_sim no)
		(at 243.84 182.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "61206c19-59c3-4ad9-a76d-a8423de00217")
	)
	(text "LEDs light when TXD/RXD go low (data).\n470R series R protect against a target\npowered from its own supply."
		(exclude_from_sim no)
		(at 151.13 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6db1179a-452d-48a1-ae20-e2b9584eabce")
	)
	(text "2. Power: 3.3V LDO + I/O voltage switch"
		(exclude_from_sim no)
		(at 13.97 116.84 0)
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "998571da-5af5-4883-a322-425610afa820")
	)
	(text "SW1 in 5V: VCC_IO = 5V, V3 floats on its 100nF cap.\nSW1 in 3V3: VCC_IO = 3.3V and V3 tied to VCC (CH340 datasheet).\nU3 (600mA) is big enough to power an ESP32 from the header."
		(exclude_from_sim no)
		(at 76.2 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ea404e37-daab-4ce6-b3df-06b2d2c3f5af")
	)
	(text "4. Headers + ESP32 auto-reset"
		(exclude_from_sim no)
		(at 149.86 124.46 0)
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "fad3cda2-54c6-4161-90f8-d157f9b60bae")
	)
